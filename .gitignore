# API keys — never commit
.env

# Claude Code project instructions
CLAUDE.md

# Large video files + HLS segments (66 GB raw MP4 + .ts renditions)
360/

# Node
node_modules/

# Claude Code machine-local state
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Python
__pycache__/
*.pyc
*.pyo
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Jupyter checkpoints
.ipynb_checkpoints/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# graphify — machine-local interpreter paths + regenerable extraction cache.
# `**/` because a bare `graphify-out/cache/` is anchored to this file's
# directory and would miss any nested graph.
**/graphify-out/cache/
**/graphify-out/.graphify_python
**/graphify-out/.graphify_root

# The portal's own graph is dev tooling, not website content — it is
# regenerable with `graphify update apps/portal/` and has no business in a branch
# that Streamlit Cloud clones on every deploy. (The ROOT graphify-out/ stays
# tracked; it predates this and CLAUDE.md's graphify section points at it.)
apps/portal/graphify-out/

# Internal planning scratch — not shipped, not reviewed.
apps/portal/plan2.md

# run_eval.py cache (regenerable, keyed by router-config hash)
ops/eval/results/.cache/

# splat-vr: build output, converted models and the .ply download cache.
# All regenerable — `bash apps/splat-vr/scripts/convert_splats.sh` then `npm run build`.
apps/splat-vr/dist/
apps/splat-vr/public/models/*.spz
apps/splat-vr/.splat-src/

# graphify curated-graph backups (one dated dir per rebuild, regenerable)
**/graphify-out/20*/

# Skills vendored into .claude/skills as symlinks into this machine's
# site-packages — committing one ships a dangling link to every other checkout
# (and to Streamlit Cloud). The skill comes from the installed package instead.
.claude/skills/developing-with-streamlit

# Streamlit Cloud log dumps downloaded from the app dashboard
logs-*.txt
