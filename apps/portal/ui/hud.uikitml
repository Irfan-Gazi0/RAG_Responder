<style>
  .hud-root {
    display: flex;
    flex-direction: column;
    background-color: #0f172a;
    border-color: #334155;
    border-width: 0.15;
    border-radius: 2;
    padding: 1.5;
    width: 60;
    gap: 1.5;
  }

  .playback-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1;
  }

  .hud-btn {
    padding: 1;
    background-color: #1e293b;
    border-color: #334155;
    border-width: 0.1;
    border-radius: 1;
    color: #e2e8f0;
    font-size: 2.2;
    font-weight: medium;
    text-align: center;
    cursor: pointer;
    width: 9;
  }

  .hud-btn-narrow { width: 5; }

  .hud-btn:hover {
    background-color: #334155;
    border-color: #64748b;
  }

  .hud-btn-active {
    background-color: #1e3a8a;
    border-color: #3b82f6;
  }

  .hud-time {
    color: #94a3b8;
    font-size: 2;
    margin-left: 1;
  }

  .seek-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1;
  }

  .hud-btn-seek { width: 8; font-size: 1.8; padding: 0.7; }

  .progress-track {
    flex-grow: 1;
    height: 1.2;
    background-color: #334155;
    border-radius: 0.6;
    overflow: hidden;
  }

  .progress-fill {
    width: 0%;
    height: 100%;
    background-color: #3b82f6;
    border-radius: 0.6;
  }

  .chat-surface {
    background-color: #1e293b;
    border-color: #334155;
    border-width: 0.1;
    border-radius: 1.5;
    padding: 1.5;
    display: flex;
    flex-direction: column;
    gap: 0.8;
  }

  .chips-row {
    display: flex;
    flex-direction: row;
    gap: 1;
  }

  .hud-chip {
    flex-grow: 1;
    padding: 0.7;
    background-color: #0f172a;
    border-color: #3b82f6;
    border-width: 0.1;
    border-radius: 2;
    color: #93c5fd;
    font-size: 1.7;
    text-align: center;
    cursor: pointer;
  }

  .hud-chip:hover { background-color: #1e3a8a; }

  .chat-scroll {
    height: 26;
    overflow: scroll;
    scrollbar-color: #64748b;
    scrollbar-width: 0.4;
    display: flex;
    flex-direction: column;
    gap: 1;
    padding-right: 1;
  }

  .scroll-row {
    display: flex;
    flex-direction: row;
    gap: 1;
  }

  /* Explicit scroll controls. UIKit's drag-to-scroll needs a held trigger dragged
     across the panel, which fights push-to-talk and is unusable with gloves; the
     left thumbstick works but nothing on screen advertises it. These use the same
     click path as the chips, which is proven on device. */
  .hud-scrollbtn {
    flex-grow: 1;
    padding: 0.7;
    background-color: #0f172a;
    border-color: #334155;
    border-width: 0.1;
    border-radius: 1;
    color: #cbd5e1;
    font-size: 1.7;
    text-align: center;
    cursor: pointer;
  }

  .hud-scrollbtn:hover {
    background-color: #334155;
    border-color: #64748b;
  }

  .chat-transcript {
    color: #3b82f6;
    font-size: 2;
    text-align: left;
    margin-top: 0.5;
  }

  .chat-hint {
    color: #94a3b8;
    font-size: 1.6;
    text-align: center;
    margin-top: 0.5;
  }

  /* Panel-level actions, side by side. The chat toggle has to live OUTSIDE
     .chat-surface or it would collapse along with the thing it restores; the
     playback row has no spare width (Pause+Mute+1/2/3+gaps is ~38 of the 57
     usable units, and #hud-time takes most of the rest), so it pairs with
     Exit VR down here instead of squeezing the seek row's progress track. */
  .bottom-row {
    display: flex;
    flex-direction: row;
    gap: 1;
  }

  .hud-toggle {
    flex-grow: 1;
    padding: 1.2;
    background-color: #1e293b;
    border-color: #334155;
    border-width: 0.1;
    border-radius: 1.2;
    color: #e2e8f0;
    font-size: 2.2;
    font-weight: medium;
    text-align: center;
    cursor: pointer;
  }

  .hud-toggle:hover {
    background-color: #334155;
    border-color: #64748b;
  }

  #xr-button {
    flex-grow: 1;
    padding: 1.2;
    background-color: #ef4444;
    color: #ffffff;
    border-radius: 1.2;
    border-width: 0.1;
    border-color: #b91c1c;
    font-size: 2.2;
    font-weight: medium;
    text-align: center;
    cursor: pointer;
  }

  #xr-button:hover {
    background-color: #dc2626;
  }
</style>

<div class="hud-root">
  <div class="playback-row">
    <button id="hud-play" class="hud-btn">Pause</button>
    <button id="hud-mute" class="hud-btn">Mute</button>
    <button id="hud-vid1" class="hud-btn hud-btn-narrow hud-btn-active">1</button>
    <button id="hud-vid2" class="hud-btn hud-btn-narrow">2</button>
    <button id="hud-vid3" class="hud-btn hud-btn-narrow">3</button>
    <span id="hud-time" class="hud-time">--:-- / --:--</span>
  </div>

  <div class="seek-row">
    <button id="hud-back10" class="hud-btn hud-btn-seek">&lt; 10s</button>
    <div id="hud-progress-track" class="progress-track">
      <div id="hud-progress-fill" class="progress-fill"></div>
    </div>
    <button id="hud-fwd10" class="hud-btn hud-btn-seek">10s &gt;</button>
  </div>

  <div id="hud-chat-surface" class="chat-surface">
    <div class="chips-row">
      <button id="hud-chip1" class="hud-chip">Shut down HV</button>
      <button id="hud-chip2" class="hud-chip">Battery fire</button>
      <button id="hud-chip3" class="hud-chip">Where to cut</button>
    </div>
    <div id="hud-chat-scroll" class="chat-scroll"></div>
    <div class="scroll-row">
      <button id="hud-scroll-up" class="hud-scrollbtn">^ Up</button>
      <button id="hud-scroll-down" class="hud-scrollbtn">v Down</button>
      <button id="hud-scroll-latest" class="hud-scrollbtn">Latest</button>
    </div>
    <span id="hud-transcript" class="chat-transcript">-</span>
    <span id="hud-hint" class="chat-hint">Hold RIGHT TRIGGER or PINCH to speak - LEFT STICK scrolls chat</span>
  </div>

  <div class="bottom-row">
    <button id="hud-chat-toggle" class="hud-toggle">Hide Chat</button>
    <button id="xr-button">Exit VR</button>
  </div>
</div>
